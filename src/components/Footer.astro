---
import profile from '../data/profile.json';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top"><div><a class="footer-name" href="#home">{profile.name}</a><p>{profile.title}</p></div><div class="footer-links"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span class="cta-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" focusable="false"><path d="M4 12 12 4M4 4h8v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="sr-only"> (opens in a new tab)</span></a><a href={`mailto:${profile.email}`}>Email <span class="cta-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" focusable="false"><path d="M4 12 12 4M4 4h8v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a></div></div>
    <div class="footer-bottom"><p>{profile.disclaimer}</p><span>© {new Date().getUTCFullYear()} {profile.name}</span></div>
  </div>
</footer>

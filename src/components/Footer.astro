---
import profile from '../data/profile.json';
import CvLink from './CvLink.astro';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top"><div><a class="footer-name" href="#home">{profile.name}</a><p>{profile.title}</p></div><div class="footer-links"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span></a><a href={`mailto:${profile.email}`}>Email ↗</a><CvLink /></div></div>
    <div class="footer-bottom"><p>{profile.disclaimer}</p><span>© {new Date().getUTCFullYear()} {profile.name}</span></div>
  </div>
</footer>

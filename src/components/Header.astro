---
import profile from '../data/profile.json';
import CvLink from './CvLink.astro';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#home"><span>{profile.name}</span></a>
    <nav aria-label="Main navigation">
      <a href="#home" class="nav-home" data-section-link="home" aria-current="location">Home</a><a href="#work" data-section-link="work">Work</a><a href="#about" data-section-link="about">About</a><CvLink class="nav-cv" />
    </nav>
    <a class="header-social" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span class="cta-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" focusable="false"><path d="M4 12 12 4M4 4h8v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="sr-only"> (opens in a new tab)</span></a>
  </div>
</header>

---
import profile from '../data/profile.json';
import CvLink from './CvLink.astro';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#home"><span class="monogram">NB<span>.</span></span><span>{profile.name}</span></a>
    <nav aria-label="Main navigation">
      <a href="#home" class="nav-home">Home</a><a href="#work">Work</a><a href="#about">About</a><CvLink class="nav-cv" />
    </nav>
    <a class="header-social" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
  </div>
</header>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvLink from '../components/CvLink.astro';
import CaseExpansion from '../components/CaseExpansion.astro';
import EvidenceList from '../components/EvidenceList.astro';
import Focus from '../components/Focus.astro';
import profile from '../data/profile.json';
import { getCollection } from 'astro:content';
const cases = (await getCollection('cases')).sort((a,b) => a.data.order-b.data.order);
const experience = (await getCollection('experience')).sort((a,b) => a.data.order-b.data.order);
const focus = (await getCollection('focus')).filter(entry=>entry.data.status!=='hidden');
const sectors = [...new Set([...cases, ...experience, ...focus].map(entry=>entry.data.sector).filter((sector): sector is string=>!!sector))];
---
<BaseLayout>
  <section class="hero container" id="home" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span>{profile.title}</p>
      <h1 id="hero-heading">{profile.headline}</h1>
      <p class="hero-description">{profile.hero}</p>
      <div class="hero-actions"><a class="button button-primary" href="#work">View selected work <span aria-hidden="true">↗</span></a><CvLink class="button button-secondary" /></div>
      <p class="hero-descriptor">{profile.descriptor}</p>
    </div>
    <figure class="portrait">
      <picture><source srcset={`${profile.portrait}.avif`} type="image/avif" /><source srcset={`${profile.portrait}.webp`} type="image/webp" /><img src={`${profile.portrait}.jpeg`} alt="Narjiss Berrazi wearing a blue top in a professional portrait." width="720" height="900" fetchpriority="high" /></picture>
      <figcaption><span>{profile.name}</span></figcaption>
    </figure>
  </section>
  <section class="proof container" aria-label="Professional profile">
    {profile.proof.map(item => <div><strong>{item.value}</strong><p>{item.label}</p></div>)}
  </section>
  <section class="section container expertise" aria-labelledby="expertise-heading">
    <div class="section-heading"><p class="eyebrow">01 / Core expertise</p><h2 id="expertise-heading">{profile.expertiseHeadline}</h2></div>
    <div class="expertise-grid">{profile.expertise.map((item,i) => <article><span class="item-number">0{i+1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </section>
  <section class="work-section" id="work" aria-labelledby="work-heading">
    <div class="container section">
      <div class="section-heading work-heading"><div><p class="eyebrow">02 / Selected work</p><h2 id="work-heading" tabindex="-1">{profile.workHeadline}</h2></div><p class="section-intro">{profile.workIntro}</p></div>
      <div class="experience-sector-filters"><p class="eyebrow">Filter projects by sector</p><div class="sector-controls" role="group" aria-label="Filter experience by sector"><button type="button" data-sector-filter="all" aria-pressed="true">All</button>{sectors.map(sector => <button type="button" data-sector-filter={sector} aria-pressed="false">{sector}</button>)}</div></div>
      <div id="sector-filter-context" class="sector-filter-context"><p id="sector-status" role="status" aria-live="polite">Showing: All</p><button id="sector-clear" type="button" class="text-control" hidden>Show all <span aria-hidden="true">×</span></button></div>
      <div class="work-list">
        {cases.map((item,i) => <article data-experience-sector={item.data.sector} class="case-row">
          <span class="case-number">0{i+1}</span>
          <div class="case-main"><p class="case-client">{item.data.clientLabel}</p><p class="sector-tag">{item.data.sector}</p><h3>{item.data.title}</h3><p>{item.data.summary}</p><ul class="tags" aria-label="Project expertise">{item.data.tags.map(tag => <li>{tag}</li>)}</ul></div>
          <aside class="case-evidence" aria-label="Selected project evidence"><span class="eyebrow">Selected evidence</span><EvidenceList evidence={item.data.evidence} /></aside>
          <CaseExpansion entry={item} />
        </article>)}
      </div>
      <p class="sector-empty-state" id="sector-empty" hidden>No experience is currently shown for this sector. Select All to return to the full portfolio.</p>
      <p class="confidentiality-note">{profile.disclaimer}</p>
    </div>
  </section>
  <section class="section container breadth" id="broader-experience" aria-labelledby="breadth-heading">
    <div class="section-heading"><p class="eyebrow">03 / Broader experience</p><h2 id="breadth-heading">{profile.experienceHeadline}</h2><p class="section-intro">{profile.experienceIntro}</p></div>
    <div class="experience-list">{experience.map(entry => <details data-experience-sector={entry.data.sector ?? ''} class:list={{'secondary-experience':entry.data.secondary}}><summary><span>{entry.data.title}<small>{entry.data.clientLabel}</small>{entry.data.sector && <span class="sector-tag">{entry.data.sector}</span>}</span><span class="details-icon" aria-hidden="true">+</span></summary><div class="experience-detail"><p>{entry.data.description}</p><p class="experience-tags">{entry.data.tags.join(' / ')}</p></div></details>)}</div>
  </section>
  <section class="about-section" id="about" aria-labelledby="about-heading"><div class="container section">
    <div class="about-grid"><div><p class="eyebrow">04 / About</p><h2 id="about-heading">{profile.aboutHeadline}</h2><p class="about-intro">{profile.about}</p><p class="about-intro about-continuation">{profile.aboutContinuation}</p></div>{focus.map(entry=><Focus entry={entry} />)}</div>
  </div></section>
  <section class="credentials container section" aria-labelledby="credentials-heading"><div class="section-heading"><p class="eyebrow">05 / Credentials</p><h2 id="credentials-heading">A foundation for transformation.</h2></div><div class="credentials-grid"><div><h3>Education</h3>{profile.education.map(education => { const [degree,institution] = education.split(' · '); return <div class="education-entry"><strong>{degree}</strong><p>{institution}</p></div>; })}<h3 class="languages-heading">Languages</h3><p class="language-copy">{profile.languages.fluent.join(', ')} — Fluent</p><p class="language-copy">{profile.languages.basic.join(' & ')} — Basic understanding</p></div><div><h3>Certifications</h3><ul class="certification-list">{profile.certifications.map(certification => <li>{certification}</li>)}</ul></div></div></section>
  <section class="contact-section" aria-labelledby="contact-heading"><div class="container contact-inner"><div><p class="eyebrow">Continue the conversation</p><h2 id="contact-heading">{profile.cta}</h2><p>{profile.ctaText}</p></div><div class="contact-actions"><a class="button button-light" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a><a class="email-link" href={`mailto:${profile.email}`}>{profile.email} ↗</a></div></div></section>
</BaseLayout>

<script>import '../scripts/portfolio';</script>

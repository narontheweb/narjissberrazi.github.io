---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvLink from '../components/CvLink.astro';
import CaseExpansion from '../components/CaseExpansion.astro';
import EvidenceList from '../components/EvidenceList.astro';
import VisualPreview from '../components/VisualPreview.astro';
import profile from '../data/profile.json';
import { getCollection } from 'astro:content';
const cases = (await getCollection('cases')).sort((a,b) => a.data.order-b.data.order);
const experience = (await getCollection('experience')).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout>
  <section class="hero container" id="home" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span>{profile.title}</p>
      <h1 id="hero-heading">{profile.headline}</h1>
      <p class="hero-description">{profile.hero}</p>
      <div class="hero-actions"><a class="button button-primary" href="#work">View selected work</a><CvLink class="button button-secondary" /></div>
    </div>
    <figure class="portrait">
      <picture><source srcset={`${profile.portrait}.avif`} type="image/avif" /><source srcset={`${profile.portrait}.webp`} type="image/webp" /><img src={`${profile.portrait}.jpeg`} alt="Narjiss Berrazi wearing a blue top in a professional portrait." width="720" height="900" fetchpriority="high" /></picture>
    </figure>
  </section>
  <section class="proof container" aria-label="Areas of expertise">
    {profile.proof.map(item => <div><strong>{item.value}</strong><p>{item.label}</p></div>)}
  </section>
  <section class="expertise-section" aria-labelledby="expertise-heading"><div class="section container expertise">
    <div class="section-heading"><p class="eyebrow">01 / Core expertise</p><h2 id="expertise-heading">{profile.expertiseHeadline}</h2><p class="section-intro">{profile.expertiseIntro}</p></div>
    <div class="expertise-grid">{profile.expertise.map((item,i) => <article><span class="item-number">0{i+1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </div></section>
  <section class="work-section" id="work" aria-labelledby="work-heading">
    <div class="container section">
      <div class="section-heading work-heading"><div><p class="eyebrow">02 / Selected work</p><h2 id="work-heading" tabindex="-1">{profile.workHeadline}</h2></div><p class="section-intro">{profile.workIntro}</p></div>
      <div class="work-list">
        {cases.map((item,i) => <article class="case-row">
          <span class="case-number">0{i+1}</span>
          <div class="case-main"><p class="case-client">{item.data.clientLabel}</p><p class="sector-tag">{item.data.sector}</p><h3>{item.data.title}</h3><p>{item.data.summary}</p><p class="focus-areas"><span>Focus areas — </span>{item.data.tags.join(' · ')}</p></div>
          <aside class="case-evidence" aria-label="Selected project evidence"><span class="eyebrow">Selected evidence</span><EvidenceList evidence={item.data.evidence} /></aside>
          <CaseExpansion entry={item} />
        </article>)}
      </div>
    </div>
  </section>
  <section class="foundation-section" id="broader-experience" aria-labelledby="breadth-heading"><div class="section container breadth">
    <div class="section-heading"><p class="eyebrow">03 / Broader experience</p><h2 id="breadth-heading">{profile.experienceHeadline}</h2><p class="section-intro">{profile.experienceIntro}</p></div>
    <div class="experience-list">{experience.map(entry => <article class:list={['experience-entry', {'secondary-experience':entry.data.secondary}]}><h3>{entry.data.title}</h3><p class="experience-client">{entry.data.clientLabel}</p>{entry.data.sector && <p class="sector-tag">{entry.data.sector}</p>}<p class="experience-description">{entry.data.description}</p></article>)}</div>
  </div></section>
  <section class="credentials-section" id="credentials" aria-labelledby="credentials-heading"><div class="credentials container section">
    <div class="section-heading"><p class="eyebrow">04 / Credentials</p><h2 id="credentials-heading">Education, Skills & Credentials</h2></div>
    <div class="credentials-grid">
      <div><h3>Education</h3>{profile.education.map(education => <div class="education-entry"><p class="education-institution">{education.institution}</p><strong>{education.degree}</strong>{education.major && <p>{education.major}</p>}{education.distinction && <p>{education.distinction}</p>}</div>)}</div>
      <div class="technical-skills"><h3>Technical Skills</h3><dl class="technical-groups">{profile.technicalSkills.map(group=><div><dt>{group.domain}</dt><dd>{group.items.join(' · ')}{group.scope && <span class="technical-scope">{group.scope}</span>}</dd></div>)}</dl></div>
      <div><h3>Certifications</h3><ul class="certification-list">{profile.certifications.map(certification => <li>{certification}</li>)}</ul></div>
      <div><h3>Languages</h3><p class="language-copy">{profile.languages.fluent.join(' · ')} — Fluent</p><p class="language-copy">{profile.languages.basic.join(' · ')} — Basic understanding</p></div>
      <div class="leadership-contributions"><h3>Leadership & Firm Contributions</h3><p><strong>{profile.firmContributions.organisation}</strong><br />{profile.firmContributions.role}</p><p>{profile.firmContributions.description}</p><p>{profile.firmContributions.coaching}</p></div>
    </div>
  </div></section>
  <section class="contact-section" aria-labelledby="contact-heading"><div class="container contact-inner"><h2 id="contact-heading">{profile.cta}</h2><a class="button button-light" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span class="cta-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" focusable="false"><path d="M4 12 12 4M4 4h8v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="sr-only"> (opens in a new tab)</span></a></div></section>
  <VisualPreview />
</BaseLayout>

<script>import '../scripts/portfolio';</script>
